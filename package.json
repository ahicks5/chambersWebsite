{
  "name": "coachingwithjc",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "astro": "astro",
    "lint:content": "node scripts/lint-content.mjs",
    "test": "npm run preview:start && playwright test; status=$?; npm run preview:stop; exit $status",
    "preview:start": "astro preview --port 4321 --host 127.0.0.1",
    "preview:stop": "astro preview stop",
    "test:smoke": "npm run preview:start && playwright test tests/smoke.spec.ts; status=$?; npm run preview:stop; exit $status",
    "test:a11y": "npm run preview:start && playwright test tests/a11y.spec.ts; status=$?; npm run preview:stop; exit $status"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
