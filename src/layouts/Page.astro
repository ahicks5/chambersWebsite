---
/**
 * Standard content page: the shell, plus the page's single h1.
 *
 * Every page that uses this gets exactly one h1 (audit §7.3) without having to
 * remember to write one.
 */
import Base from './Base.astro';
import PageHero from '../components/sections/PageHero.astro';

interface Props {
  title: string;
  description: string;
  page: string;
  /** The visible h1. Often differs from the <title> — audit §7.2. */
  h1: string;
  subhead?: string;
  noindex?: boolean;
}

const { title, description, page, h1, subhead, noindex } = Astro.props;
---

<Base {title} {description} {page} {noindex}>
  <PageHero {h1} {subhead} />

  <slot />
</Base>

<style>
</style>
