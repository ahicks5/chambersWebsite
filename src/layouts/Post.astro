---
/**
 * Blog post layout — audit §7.4.
 *
 * "Every post ends the same way: author box with ICF badge, lead-magnet form,
 * and Book a free intro call." That ending is the reason the blog earns its
 * keep: it is the only place cold search traffic meets an offer.
 *
 * Drafts render at their real URL but are noindex and clearly marked, so John
 * can read a migrated post on a deploy preview without it being publishable.
 * See ADR 0007.
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';

import Base from './Base.astro';
import Section from '../components/layout/Section.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';
import LeadMagnet from '../components/sections/LeadMagnet.astro';
import { site } from '../config/site';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, draft } = post.data;

const { Content } = await render(post);

const author = await getEntry('bands', 'post-author');
if (!author) throw new Error('Missing src/content/bands/post-author.md');
const { Content: Author } = await render(author);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title={`${title} | ${site.name}`}
  {description}
  page="blog"
  noindex={draft}
>
  <article>
    <Section>
      {
        draft && (
          <p class="draft" role="note">
            <strong>Draft — not published.</strong> Migrated from the old site and
            waiting on a read. The category below is a guess.
          </p>
        )
      }

      <p class="meta">
        <a href={`/blog/category/${category}`}>{category}</a>
        <span> · </span>
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span class="meta__updated"> · updated {fmt(updatedDate)}</span>}
      </p>

      <h1>{title}</h1>
    </Section>

    <Section>
      <Prose class="post">
        <Content />
      </Prose>
    </Section>
  </article>

  {/* The standard ending — audit §7.4. */}
  <Section alt aria-labelledby="post-author">
    <div class="author">
      <h2 id="post-author">{author.data.title}</h2>
      <Prose>
        <Author />
      </Prose>
      <p class="author__badges">{site.credentials.slice(0, 3).join(' · ')}</p>
      <Button cta="intro" page="blog" position="post-footer" />
    </div>
  </Section>

  <LeadMagnet />
</Base>

<style>
  .draft {
    max-width: var(--measure);
    margin-bottom: var(--s-4);
    padding: var(--s-3);
    background: var(--c-surface);
    border: 1px dashed var(--c-line);
    border-radius: var(--radius);
    color: var(--c-muted);
  }

  .meta {
    margin: 0 0 var(--s-2);
    color: var(--c-muted);
    font-size: 0.95rem;
  }

  .meta a {
    color: var(--c-accent);
    font-weight: 600;
  }

  .post :global(h2) {
    margin-block: var(--s-6) var(--s-2);
  }

  .post :global(blockquote) {
    font-size: 1.1rem;
  }

  .author {
    max-width: var(--measure);
  }

  .author__badges {
    margin-block: var(--s-2) var(--s-4);
    color: var(--c-muted);
    font-size: 0.95rem;
  }
</style>
