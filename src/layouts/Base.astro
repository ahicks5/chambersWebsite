---
/**
 * The html shell. Header, slot, Footer.
 *
 * Deliberately does not render an h1 — audit §7.3 wants exactly one per page and
 * that belongs to the page, not the shell.
 *
 * Per-page meta is required, not optional: audit §2.8 bug 3 is the Contact page
 * shipping the Resources page's meta description. TypeScript enforces it here.
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import StickyCta from '../components/islands/StickyCta.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site';
import type { CtaKey } from '../config/cta';

interface Props {
  /** <title> — audit §7.2 caps these at 60 characters. */
  title: string;
  /** Meta description — unique per page, 50–160 characters. */
  description: string;
  /** Page identifier for CTA attribution: `home`, `coaching`, … */
  page: string;
  /** Header CTA — see Header.astro. Organizations pages pass `consult`. */
  headerCta?: Extract<CtaKey, 'intro' | 'consult'>;
  noindex?: boolean;
}

const { title, description, page, headerCta = 'intro', noindex = false } = Astro.props;

/**
 * Keep the staging site out of search results — and take it back out again by
 * itself at cutover.
 *
 * Until DNS moves, the Netlify subdomain serves a near-complete copy of
 * coachingwithjc.com. Indexed, it competes with John's real site for his own
 * terms. Netlify sets URL to the site's primary address at build time, so when
 * that address becomes the real domain this stops applying with nothing to
 * remember and no dashboard toggle to find.
 *
 * Absent env (a local build) counts as not-production, which errs toward
 * noindex. That is the safe direction for a site that is not launched, but it
 * does mean a production deploy missing this variable would ship noindex — so
 * "confirm the live site is indexable" is a cutover check in
 * docs/parity-checklist.md.
 */
const deployUrl = process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? '';
const isCanonicalHost = new URL(site.url).host;
const onCanonicalDomain = deployUrl !== '' && new URL(deployUrl).host === isCanonicalHost;
const robots = noindex || !onCanonicalDomain ? 'noindex' : null;
const canonical = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/*
      The H1 weight only. It is the largest text on every page and paints
      first, so it is the one file worth spending a preload on (audit §10).
      The 400 file follows as soon as the stylesheet parses.
    */}
    <link
      rel="preload"
      href="/fonts/bitter-black-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Gates the scroll-reveal hidden state (global.css). Inline and first so
      it runs before the first paint — nothing flashes visible then hides.
      With JS off the attribute never lands and everything is simply visible.
    */}
    <script is:inline>document.documentElement.dataset.reveal = '';</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <meta name="generator" content={Astro.generator} />

    {/* Per-page <head> additions — JSON-LD, preloads. Pass slot="head". */}
    <slot name="head" />
  </head>

  <body class="scheme-green">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header page={page} cta={headerCta} />
    <StickyCta cta={headerCta} {page} />
    <main id="main">
      <slot />
    </main>
    <Footer {page} cta={headerCta} />
  </body>
</html>

<script>
  // Scroll reveal — audit §9.4, translated off the Velo `onViewportEnter`.
  // One observer, no framework; each block is revealed once and released.
  const blocks = [...document.querySelectorAll<HTMLElement>('.reveal')];

  const show = (el: Element) => el.classList.add('is-in');

  if (blocks.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          show(entry.target);
          io.unobserve(entry.target);
        }
        // Anything now above the viewport was jumped past — an anchor link,
        // a fast fling, a restored scroll position — and never intersected.
        // Reveal it too, or it stays hidden until the visitor scrolls back up.
        for (const el of blocks) {
          if (!el.classList.contains('is-in') && el.getBoundingClientRect().bottom < 0) {
            show(el);
            io.unobserve(el);
          }
        }
      },
      // Threshold 0, not a fraction: a block taller than twenty screens (the
      // blog index on a phone) never shows 5% of itself at once, and with a
      // fractional threshold it stayed hidden while the visitor was inside it.
      { rootMargin: '0px 0px -8% 0px', threshold: 0 }
    );
    blocks.forEach((el) => io.observe(el));
  } else {
    blocks.forEach(show);
  }
</script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
  }

  .skip-link:focus {
    left: var(--s-2);
    top: var(--s-2);
    z-index: 20;
    padding: var(--s-1) var(--s-2);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
</style>
