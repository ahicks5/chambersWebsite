---
/**
 * The html shell. Header, slot, Footer.
 *
 * Deliberately does not render an h1 — audit §7.3 wants exactly one per page and
 * that belongs to the page, not the shell.
 *
 * Per-page meta is required, not optional: audit §2.8 bug 3 is the Contact page
 * shipping the Resources page's meta description. TypeScript enforces it here.
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site';
import type { CtaKey } from '../config/cta';

interface Props {
  /** <title> — audit §7.2 caps these at 60 characters. */
  title: string;
  /** Meta description — unique per page, 50–160 characters. */
  description: string;
  /** Page identifier for CTA attribution: `home`, `coaching`, … */
  page: string;
  /** Header CTA — see Header.astro. Organizations pages pass `consult`. */
  headerCta?: Extract<CtaKey, 'intro' | 'consult'>;
  noindex?: boolean;
}

const { title, description, page, headerCta = 'intro', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.name} />
    <meta name="generator" content={Astro.generator} />

    {/* Per-page <head> additions — JSON-LD, preloads. Pass slot="head". */}
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header page={page} cta={headerCta} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
  }

  .skip-link:focus {
    left: var(--s-2);
    top: var(--s-2);
    z-index: 20;
    padding: var(--s-1) var(--s-2);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
</style>
