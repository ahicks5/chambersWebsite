---
/**
 * The only way a CTA reaches the page.
 *
 * Takes a key from `src/config/cta.ts` — never a label. Audit §4.3: six CTA
 * labels across five Calendly events is the bug this component exists to
 * prevent. There is no `label` prop, by design.
 */
import { CTA, ctaHref, type CtaKey } from '../../config/cta';

interface Props {
  /** Which CTA — `intro` and `consult` are the two primaries, `lead` is soft. */
  cta: CtaKey;
  /** Page the button sits on, for UTM attribution: `home`, `coaching`, … */
  page: string;
  /** Position on that page, for UTM attribution: `hero`, `mid`, `footer`, … */
  position: string;
  /**
   * Override the CTA's default style. Use sparingly — see audit §4.3.
   * `inverse` is the primary as it appears on an accent band (ADR 0009): same
   * label, same URL, fill and label colours swapped so it stays visible.
   */
  style?: 'primary' | 'ghost' | 'inverse';
  /**
   * `compact` is for the sticky header, where the CTA sits beside the nav rather
   * than in a content section. Size lives here because Astro's scoped styles do
   * not cross component boundaries — a parent cannot restyle this button by
   * passing a class.
   */
  size?: 'default' | 'compact';
  class?: string;
}

const { cta, page, position, style, size = 'default', class: className } = Astro.props;

const { label } = CTA[cta];
const href = ctaHref(cta, page, position);
const variant = style ?? CTA[cta].style;
const isExternal = href.startsWith('http');
---

<a
  href={href}
  class:list={['button', `button--${variant}`, size !== 'default' && `button--${size}`, className]}
  rel={isExternal ? 'noopener' : undefined}
>
  <span class="button__label">{label}</span>
  {/* Decorative. The label carries the meaning; the arrow carries the hover. */}
  <svg class="button__arrow" aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
    <path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 999px;
    padding: 0.95rem 1.5rem 0.95rem 1.7rem;
    font-weight: var(--fw-heading);
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .button__arrow {
    flex: 0 0 auto;
    transition: transform var(--dur) var(--ease);
  }

  .button:hover .button__arrow {
    transform: translateX(3px);
  }

  /* On the filled buttons the arrow sits in a small disc of the label colour,
     so the pill has a second shape inside it and does not read as a plain
     capsule of text. Sized to the line height so the button grows nowhere.
     The two colours are the button's own, swapped. */
  .button--primary .button__arrow,
  .button--inverse .button__arrow {
    box-sizing: content-box;
    width: 12px;
    height: 12px;
    padding: 0.3rem;
    margin-inline-end: -0.7rem;
    border-radius: 999px;
    background: currentColor;
  }

  .button--primary .button__arrow path {
    stroke: var(--c-accent);
  }

  .button--inverse .button__arrow path {
    stroke: var(--c-accent-ink);
  }

  .button--compact.button--primary .button__arrow,
  .button--compact.button--inverse .button__arrow {
    width: 11px;
    height: 11px;
    padding: 0.22rem;
    margin-inline-end: -0.5rem;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  /* Press: back down, no lift. Feels like a button, not a sticker. */
  .button:active {
    transform: translateY(0) scale(0.985);
    box-shadow: none;
    transition-duration: 0.08s;
  }

  /* Audit §4.3: one filled primary per screen, everything else outline. */
  .button--primary {
    background: var(--c-accent);
    color: var(--c-accent-ink);
    border: 2px solid var(--c-accent);
  }

  .button--ghost {
    background: transparent;
    color: var(--c-accent);
    border: 2px solid var(--c-accent);
  }

  .button--ghost:hover {
    background: var(--c-surface);
  }

  .button--inverse {
    background: var(--c-accent-ink);
    color: var(--c-accent);
    border: 2px solid var(--c-accent-ink);
  }

  .button--compact {
    gap: 0.45rem;
    padding: 0.55rem 0.95rem 0.55rem 1.1rem;
    font-size: 0.95rem;
  }

  .button--compact.button--ghost .button__arrow {
    width: 13px;
    height: 13px;
  }

  /* Beside a wrapping brand on a phone, every pixel of width matters. */
  @media (max-width: 639px) {
    .button--compact {
      padding: 0.5rem 0.8rem 0.5rem 0.9rem;
      font-size: 0.875rem;
    }
  }

  /* Audit §8.4: full-width on mobile, auto on desktop. The header CTA sits
     beside the nav rather than in a content section, so it opts out. */
  @media (max-width: 639px) {
    .button:not(.button--compact) {
      display: flex;
      width: 100%;
    }
  }
</style>