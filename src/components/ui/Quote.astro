---
/**
 * A testimonial quote and its attribution.
 *
 * This component owns the consent rule: `firstName` renders only when
 * `consent === 'named'`. That is a promise made to real clients, so the check
 * lives here rather than at each call site where it could be forgotten.
 *
 * Attribution degrades to the most specific form the data supports — audit
 * appendix C, and docs/decisions/0006-testimonial-attribution.md for why role
 * and industry may be missing.
 *
 * Not boxed. A quote in a card with a border and a shadow looked like the
 * offer cards, and a client's words are not a product. The opening mark in
 * Bitter Black is the whole decoration.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { testimonial } = Astro.props;
const { firstName, role, industry, engagement, consent, rating } = testimonial.data;

const named = consent === 'named' && firstName;
const who = [named ? firstName : null, role, industry].filter(Boolean).join(', ');

// "Priya, Engineering Manager · SaaS (3-month partnership)" down to
// "3-month partnership" when nothing else is cleared for publication.
const attribution = who ? `${who} (${engagement})` : engagement;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption class="quote__attrib">
    {
      rating && (
        <span class="quote__stars">
          <span class="visually-hidden">Rated {rating} out of 5.</span>
          {Array.from({ length: 5 }, (_, i) => (
            <svg
              class:list={['star', i < rating && 'star--on']}
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="14"
              height="14"
            >
              <path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z" />
            </svg>
          ))}
        </span>
      )
    }
    <span>{attribution}</span>
  </figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-line);
  }

  .quote blockquote {
    margin: 0 0 var(--s-3);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .quote blockquote::before {
    content: '\201C';
    display: block;
    height: 0.55em;
    margin-bottom: var(--s-2);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--c-accent);
  }

  .quote blockquote :global(p) {
    margin: 0 0 var(--s-2);
  }

  .quote blockquote :global(p:last-child) {
    margin-bottom: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Stars in the heading colour: filled for the score, outlined for the rest.
     A second point of proof beside the attribution, not a new colour. */
  .quote__stars {
    display: inline-flex;
    gap: 2px;
    margin-right: var(--s-2);
    vertical-align: -2px;
    color: var(--c-accent);
  }

  .star {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .star--on {
    fill: currentColor;
  }

  .quote__attrib {
    margin-top: auto;
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
</style>
