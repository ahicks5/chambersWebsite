---
/**
 * A testimonial quote and its attribution.
 *
 * This component owns the consent rule: `firstName` renders only when
 * `consent === 'named'`. That is a promise made to real clients, so the check
 * lives here rather than at each call site where it could be forgotten.
 *
 * Attribution degrades to the most specific form the data supports — audit
 * appendix C, and docs/decisions/0006-testimonial-attribution.md for why role
 * and industry may be missing.
 *
 * Not boxed. A quote in a card with a border and a shadow looked like the
 * offer cards, and a client's words are not a product. The opening mark in
 * Bitter Black is the whole decoration.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { testimonial } = Astro.props;
const { firstName, role, industry, engagement, consent } = testimonial.data;

const named = consent === 'named' && firstName;
const who = [named ? firstName : null, role, industry].filter(Boolean).join(', ');

// "Priya, Engineering Manager · SaaS (3-month partnership)" down to
// "3-month partnership" when nothing else is cleared for publication.
const attribution = who ? `${who} (${engagement})` : engagement;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption class="quote__attrib">{attribution}</figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-line);
  }

  .quote blockquote {
    margin: 0 0 var(--s-3);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .quote blockquote::before {
    content: '\201C';
    display: block;
    height: 0.55em;
    margin-bottom: var(--s-2);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--c-accent);
  }

  .quote blockquote :global(p) {
    margin: 0 0 var(--s-2);
  }

  .quote blockquote :global(p:last-child) {
    margin-bottom: 0;
  }

  .quote__attrib {
    margin-top: auto;
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
</style>
