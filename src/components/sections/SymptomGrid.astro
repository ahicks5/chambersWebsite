---
/**
 * "Sound familiar?" — audit §5.2 section 3.
 *
 * The four symptoms are already written on the live homepage, buried in twelve
 * paragraphs of prose. As cards they do the recognition work in one screen.
 */
import { getCollection, render } from 'astro:content';
import Section from '../layout/Section.astro';

const symptoms = (await getCollection('symptoms')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  symptoms.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Section aria-labelledby="sound-familiar">
  <h2 id="sound-familiar">Sound familiar?</h2>

  <ul class="symptoms stagger">
    {
      rendered.map(({ entry, Content }) => (
        <li>
          <h3>{entry.data.title}</h3>
          <Content />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* Four statements separated by rules, not four boxes. The words do the
     recognition work; a filled tile only adds furniture. */
  .symptoms {
    display: grid;
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .symptoms li {
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--c-line);
  }

  /* Audit §8.4: 1 column mobile, 2 at 640px, never five. */
  @media (min-width: 640px) {
    .symptoms {
      grid-template-columns: repeat(2, 1fr);
    }

    .symptoms li {
      padding: var(--s-4) var(--s-4) var(--s-4) 0;
    }

    .symptoms li:nth-child(2n) {
      padding-left: var(--s-4);
      border-left: 1px solid var(--c-line);
    }
  }

  @media (min-width: 1024px) {
    .symptoms {
      grid-template-columns: repeat(4, 1fr);
    }

    .symptoms li:nth-child(n + 2) {
      padding-left: var(--s-4);
      border-left: 1px solid var(--c-line);
    }
  }

  .symptoms h3 {
    margin-bottom: var(--s-1);
    font-size: var(--fs-h3);
  }

  .symptoms :global(p) {
    margin: 0;
    color: var(--c-muted);
  }
</style>