---
/**
 * "Meet John" — audit §5.2 section 7.
 *
 * Faces build trust faster than words, and on the live site the photo comes
 * after twelve paragraphs of copy (audit §2.1). Copy comes from
 * src/content/bands/meet-john.md.
 */
import { getEntry, render } from 'astro:content';
import Section from '../layout/Section.astro';

const band = await getEntry('bands', 'meet-john');
if (!band) throw new Error('Missing src/content/bands/meet-john.md');
const { Content } = await render(band);
---

<Section aria-labelledby="meet-john">
  <div class="meet">
    {/* Second photo slot — see the note in Hero.astro. */}
    <div class="meet__photo" role="presentation">
      <p class="meet__photo-note">Photo of John goes here.</p>
    </div>

    <div class="meet__text">
      <h2 id="meet-john">{band.data.title}</h2>
      <Content />
      <p><a href="/about" class="more">Read more →</a></p>
    </div>
  </div>
</Section>

<style>
  .meet {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 700px) {
    .meet {
      grid-template-columns: 14rem 1fr;
      gap: var(--s-6);
      align-items: center;
    }
  }

  .meet__photo {
    aspect-ratio: 4 / 5;
    max-width: 100%;
    display: grid;
    place-items: center;
    padding: var(--s-3);
    background: var(--c-surface);
    border: 1px dashed var(--c-line);
    border-radius: var(--radius);
  }

  .meet__photo-note {
    margin: 0;
    text-align: center;
    color: var(--c-muted);
    font-size: 0.95rem;
  }

  .meet__text :global(p) {
    max-width: var(--measure);
  }
</style>
