---
/**
 * "Meet John" — audit §5.2 section 7.
 *
 * Faces build trust faster than words, and on the live site the photo comes
 * after twelve paragraphs of copy (audit §2.1). Copy comes from
 * src/content/bands/meet-john.md.
 */
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '../layout/Section.astro';
import { site } from '../../config/site';
import candid from '../../assets/john-chambers-candid.jpg';

const band = await getEntry('bands', 'meet-john');
if (!band) throw new Error('Missing src/content/bands/meet-john.md');
const { Content } = await render(band);
---

<Section rule aria-labelledby="meet-john">
  <div class="meet">
    {/* A different photo from the hero's: the candid from his live About page. */}
    <Image
      class="meet__photo"
      src={candid}
      alt={site.person}
      widths={[480, 768, 1000]}
      sizes="(min-width: 700px) 14rem, calc(100vw - 3rem)"
      loading="lazy"
    />

    <div class="meet__text">
      <h2 id="meet-john">{band.data.title}</h2>
      <Content />
      <p><a href="/about" class="more">Read more →</a></p>
    </div>
  </div>
</Section>

<style>
  .meet {
    display: grid;
    gap: var(--s-4);
  }

  @media (min-width: 700px) {
    .meet {
      grid-template-columns: 14rem 1fr;
      gap: var(--s-6);
      align-items: center;
    }
  }

  /* A child component's root element, so :global() — see Header.astro. */
  .meet :global(.meet__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* Stacked on a phone the photo is a portrait beside nothing; cap it so the
     band does not become one tall picture with a caption. */
  @media (max-width: 699px) {
    .meet :global(.meet__photo) {
      max-width: 18rem;
    }
  }

  .meet__text :global(p) {
    max-width: var(--measure);
  }
</style>
