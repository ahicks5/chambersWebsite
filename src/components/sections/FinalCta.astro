---
/**
 * Closing CTA — audit §5.2 section 10.
 *
 * Same CTA *label* as the hero and header on any given page; audit §4.3 says
 * repeating one CTA is fine and offering different ones is not. The surrounding
 * copy differs per page, which is why it comes from a band rather than being
 * typed in here.
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import Section from '../layout/Section.astro';
import type { CtaKey } from '../../config/cta';

interface Props {
  /** id of the entry in src/content/bands/, e.g. `final-cta-home`. */
  band: CollectionEntry<'bands'>['id'];
  cta?: CtaKey;
  page: string;
}

const { band: bandId, cta = 'intro', page } = Astro.props;

const band = await getEntry('bands', bandId);
if (!band) throw new Error(`Missing src/content/bands/${bandId}.md`);
const { Content } = await render(band);
---

{/*
  Closes every page that has a closing CTA, on the page colour and a size up,
  so the hero and this band bracket the page (ADR 0009, 0010).
*/}
<Section size="roomy" rule class="final-section" aria-labelledby="final-cta">
  <div class="final">
    <h2 id="final-cta">{band.data.title}</h2>
    <Content />
    <Button {cta} {page} position="final" />
  </div>
</Section>

<style>
  /* The hero's landscape returns, mirrored and rising from the bottom edge,
     so the opening and closing bands carry the same weather. Same blend,
     opacity and files as Hero.astro; the mask runs the other way. */
  :global(.final-section) {
    position: relative;
    isolation: isolate;
    /* The blend needs a backdrop inside this stacking context, or the photo
       paints in its own colours over nothing. */
    background: var(--c-bg);
  }

  :global(.final-section)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/images/hero-bg-900.webp') center 30% / cover no-repeat;
    transform: scaleX(-1);
    mix-blend-mode: luminosity;
    opacity: 0.26;
    mask-image: linear-gradient(to top, black 35%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, black 35%, transparent 100%);
  }

  @media (min-width: 900px) {
    :global(.final-section)::before {
      background-image: url('/images/hero-bg-1800.webp');
    }
  }

  .final {
    display: grid;
    justify-items: start;
    max-width: var(--measure);
  }

  .final h2 {
    max-width: 20ch;
    font-size: var(--fs-h1);
    line-height: 1.05;
  }

  .final :global(p) {
    margin-block: var(--s-3) var(--s-6);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
</style>
