---
/**
 * Closing CTA — audit §5.2 section 10.
 *
 * Same CTA *label* as the hero and header on any given page; audit §4.3 says
 * repeating one CTA is fine and offering different ones is not. The surrounding
 * copy differs per page, which is why it comes from a band rather than being
 * typed in here.
 */
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import Section from '../layout/Section.astro';
import type { CtaKey } from '../../config/cta';

interface Props {
  /** id of the entry in src/content/bands/, e.g. `final-cta-home`. */
  band: CollectionEntry<'bands'>['id'];
  cta?: CtaKey;
  page: string;
}

const { band: bandId, cta = 'intro', page } = Astro.props;

const band = await getEntry('bands', bandId);
if (!band) throw new Error(`Missing src/content/bands/${bandId}.md`);
const { Content } = await render(band);
---

{/*
  The one accent band on the page (ADR 0009). It closes every page that has a
  closing CTA, so the hero and this band bracket the page: quiet and large at
  the top, saturated at the bottom.
*/}
<Section tone="accent" aria-labelledby="final-cta">
  <div class="final">
    <h2 id="final-cta">{band.data.title}</h2>
    <Content />
    <Button {cta} {page} position="final" style="inverse" />
  </div>
</Section>

<style>
  .final {
    display: grid;
    justify-items: start;
    max-width: var(--measure);
  }

  .final h2 {
    max-width: 20ch;
  }

  .final :global(p) {
    margin-block: var(--s-3) var(--s-6);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
</style>
