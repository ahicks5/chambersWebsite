---
/**
 * Proof strip — audit §5.2 section 2, §3.2 step 3, §3.3.
 *
 * The audit's finding 6: these signals exist but are buried. "ICF-certified"
 * sits mid-paragraph on the live homepage, "12 years HR" only on Services, and
 * the three journals only on a Resources page missing from the nav.
 *
 * §3.3 asks for badges and a logo strip. There are no logo files yet, so the
 * two kinds of claim get two typographic treatments instead: credentials as
 * badges, institutions as a tracked wordmark row — the way a logo strip reads
 * when the logos are text. Both lists come from src/config/site.ts.
 */
import { site } from '../../config/site';
import Section from '../layout/Section.astro';
---

<Section size="compact" reveal={false} class="proof-section" aria-label="Credentials">
  <div class="proof">
    <div class="proof__group">
      <span class="eyebrow">Credentials</span>
      <ul class="proof__list">
        {site.credentials.map((credential) => <li>{credential}</li>)}
      </ul>
    </div>

    <div class="proof__group">
      <span class="eyebrow">Trained at</span>
      <ul class="proof__list proof__list--marks">
        {site.trainedAt.map((place) => <li>{place}</li>)}
      </ul>
    </div>
  </div>
</Section>

<style>
  /* Bounded by rules, not filled: it reads as the last line of the hero. */
  :global(.proof-section) {
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }

  .proof {
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 900px) {
    .proof {
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--s-6);
    }
  }

  .proof__group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
  }

  .proof__group .eyebrow {
    display: inline;
    color: var(--c-muted);
  }

  .proof__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }

  .proof__list li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  /* Middot between items, not after the last. */
  .proof__list li:not(:last-child)::after {
    content: '·';
    color: var(--c-muted);
  }

  .proof__list--marks li {
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
