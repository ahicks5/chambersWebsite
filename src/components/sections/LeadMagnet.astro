---
/**
 * Burnout check — audit §5.2 section 9, appendix D.
 *
 * Audit finding 9: there is no lead capture on the live homepage at all. The
 * newsletter form exists only on the blog, the least-visited page, so the 90%+
 * of visitors who are not ready to spend $145 today leave with nothing.
 *
 * Posts to Netlify Forms (ADR 0005) — an attribute on the form, no backend, no
 * client JS. Netlify picks the form up from the built HTML at deploy time.
 *
 * Two pieces are still missing and are tracked in docs/parity-checklist.md: the
 * PDF itself, and the ESP automation that emails it. Until then submissions
 * collect in the Netlify dashboard, which is why the button says "Send me the
 * check" and the copy promises no instant download.
 */
import { getEntry, render } from 'astro:content';
import Section from '../layout/Section.astro';

const band = await getEntry('bands', 'lead-magnet');
if (!band) throw new Error('Missing src/content/bands/lead-magnet.md');
const { Content } = await render(band);
---

<Section tone="light" aria-labelledby="burnout-check">
  <div class="magnet">
    <div class="magnet__body">
    <h2 id="burnout-check">{band.data.title}</h2>
    <Content />

    <form
      class="magnet__form"
      name="burnout-check"
      method="POST"
      action="/thanks/"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
    >
      {/* Spam trap. Real people never fill this in; bots do. */}
      <p class="magnet__honeypot">
        <label>
          Leave this field empty
          <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="magnet__row">
        <label class="magnet__label" for="magnet-email">Email address</label>
        <input
          id="magnet-email"
          type="email"
          name="email"
          autocomplete="email"
          required
          placeholder="you@example.com"
        />
        <button type="submit" class="button button--primary">Send me the check</button>
      </div>
    </form>

    {
      band.data.note && (
        <p class="magnet__privacy">
          {band.data.note} <a href="/privacy">Privacy</a>.
        </p>
      )
    }
    </div>

    {/*
      The figure from the band, set large in a ring with the checklist's tick
      on its shoulder: the "2 minutes" the copy promises, made visible.
      Decorative — the copy already says it.
    */}
    {
      band.data.figure && (
        <div class="magnet__mark" aria-hidden="true">
          <span class="magnet__figure">{band.data.figure}</span>
          <span class="magnet__figure-label">{band.data.figureLabel}</span>
        </div>
      )
    }
  </div>
</Section>

<style>
  .magnet {
    display: grid;
    gap: var(--s-4);
    align-items: center;
  }

  @media (min-width: 900px) {
    .magnet {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-12);
    }
  }

  .magnet h2,
  .magnet p,
  .magnet :global(p) {
    max-width: var(--measure);
  }

  /* The ring: a hairline circle in the accent, the figure at headline size
     inside it, its label under. On phones it leads the band, small; beside
     the form on a wide screen, large. */
  .magnet__mark {
    position: relative;
    order: -1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.2rem;
    width: 7.5rem;
    aspect-ratio: 1;
    border: 2px solid var(--c-accent);
    border-radius: 999px;
  }

  @media (min-width: 900px) {
    .magnet__mark {
      order: 0;
      width: 13rem;
      justify-self: end;
      margin-inline-end: var(--s-6);
    }
  }

  .magnet__figure {
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-h1);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-accent);
  }

  .magnet__figure-label {
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  /* The tick on the ring's shoulder: a filled disc in the accent (::after)
     with the mark drawn in the accent's ink (::before), the same shapes as
     the "Sound familiar?" checklist. */
  .magnet__mark::after {
    content: '';
    position: absolute;
    top: 4%;
    right: 4%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--c-accent);
  }

  .magnet__mark::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: calc(4% + 11%);
    right: calc(4% + 11%);
    width: 6%;
    height: 11%;
    border-right: 2.5px solid var(--c-accent-ink);
    border-bottom: 2.5px solid var(--c-accent-ink);
    transform: translate(50%, -58%) rotate(45deg);
  }

  /* With the reveal active the tick lands after the band has risen, the
     way the checklist's do. Same gate as global.css. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-reveal] .reveal) .magnet__mark::after,
    :global(html[data-reveal] .reveal) .magnet__mark::before {
      opacity: 0;
      transition: opacity var(--dur) var(--ease) 0.6s;
    }

    :global(html[data-reveal] .reveal.is-in) .magnet__mark::after,
    :global(html[data-reveal] .reveal.is-in) .magnet__mark::before {
      opacity: 1;
    }
  }

  .magnet__form {
    margin-top: var(--s-4);
  }

  /* Visually hidden but still reachable, so a bot filling everything trips it. */
  .magnet__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .magnet__row {
    display: grid;
    gap: var(--s-2);
    max-width: 34rem;
  }

  @media (min-width: 640px) {
    .magnet__row {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .magnet__label {
      grid-column: 1 / -1;
    }
  }

  .magnet__label {
    font-weight: var(--fw-heading);
    font-size: 0.95rem;
  }

  .magnet__row input {
    width: 100%;
    min-width: 0;
    padding: 0.85rem 1rem;
    font: inherit;
    color: var(--c-field-text);
    background: var(--c-field-bg);
    border: 2px solid var(--c-line-strong);
    border-radius: var(--radius);
  }

  /* Button styling is duplicated from Button.astro because this is a <button>
     inside a form, not a CTA link. Button.astro takes a cta key by design and
     has no submit mode — audit §4.3 keeps those two things separate. */
  .magnet__row .button {
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    font: inherit;
    font-weight: var(--fw-heading);
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .button:active {
    transform: translateY(0) scale(0.985);
    box-shadow: none;
    transition-duration: 0.08s;
  }

  .magnet__row .button--primary {
    background: var(--c-accent);
    color: var(--c-accent-ink);
    border: 2px solid var(--c-accent);
  }

  .magnet__privacy {
    margin-top: var(--s-3);
    color: var(--c-muted);
    font-size: 0.95rem;
  }

  .magnet__privacy a {
    color: inherit;
  }
</style>
