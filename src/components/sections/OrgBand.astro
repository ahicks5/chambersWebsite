---
/**
 * Organizations band — audit §5.2 section 8.
 *
 * Audit finding 4: individuals and organizations share one funnel on the live
 * site. The homepage is the individual's page, so the org pitch is one band with
 * the secondary CTA, and the real pitch lives on its own page (§5.4).
 */
import { getEntry, render } from 'astro:content';
import Button from '../ui/Button.astro';
import Section from '../layout/Section.astro';

const band = await getEntry('bands', 'org-band');
if (!band) throw new Error('Missing src/content/bands/org-band.md');
const { Content } = await render(band);
---

<Section size="compact" class="org-section" aria-labelledby="for-organizations">
  <div class="org">
    <div class="org__text">
      <h2 id="for-organizations">{band.data.title}</h2>
      <Content />
      <p><a href="/for-organizations" class="more">See how I work with teams →</a></p>
    </div>

    <Button cta="consult" page="home" position="org-band" style="ghost" />
  </div>
</Section>

<style>
  /* A panel on the page colour, like the decision row on its band: a
     hairline, the surface tint and a radius, so the secondary pitch is one
     framed object between Meet John and the burnout check rather than a
     strip that reads as more page. */
  :global(.org-section) {
    border-top: 1px solid var(--c-line);
  }

  .org {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-4);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }

  .org h2 {
    font-size: var(--fs-h3);
  }

  @media (min-width: 900px) {
    .org {
      grid-template-columns: 1fr auto;
      gap: var(--s-8);
      align-items: center;
      padding: var(--s-6);
    }
  }

  .org__text :global(p) {
    max-width: var(--measure);
  }
</style>
