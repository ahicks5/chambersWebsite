---
/**
 * Three testimonials — audit §5.2 section 6.
 *
 * Audit §2.4: testimonials convert when they sit next to the CTA on the page
 * where the decision is made, not on a separate archive page. These are the real
 * quotes migrated from the live site.
 *
 * Build-time only — getCollection runs during the build, so this ships zero
 * client JS. The live site does the same job with a wixData query in the
 * browser (audit §9.3); the behaviour is right, the API is not.
 */
import { getCollection, render } from 'astro:content';
import Quote from '../ui/Quote.astro';
import Section from '../layout/Section.astro';

interface Props {
  segment?: 'individual' | 'organization';
  heading?: string;
  alt?: boolean;
}

const { segment = 'individual', heading = 'What clients say', alt = true } = Astro.props;

const all = await getCollection('testimonials');

const featured = all
  .filter(({ data }) => data.segment === segment && data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const rendered = await Promise.all(
  featured.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Section {alt} class="quotes-section" aria-labelledby="what-clients-say">
  <h2 id="what-clients-say">{heading}</h2>

  <ul class="band stagger">
    {
      rendered.map(({ entry, Content }) => (
        <li>
          <Quote testimonial={entry}>
            <Content />
          </Quote>
        </li>
      ))
    }
  </ul>

  <p class="band__more">
    <a href="/testimonials" class="more">Read all {all.length} →</a>
  </p>
</Section>

<style>
  /* Behind the quotes: the hero's landscape, faint and fading at both edges,
     and one enormous opening mark in the surface tint at the top right —
     the same glyph each quote opens with, at the size of the band. Both sit
     under the content by the negative z-index inside the band's own
     stacking context; overflow is clipped so the glyph never widens the
     page. */
  :global(.quotes-section) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-bg);
  }

  :global(.quotes-section)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/images/hero-bg-900.webp') center 65% / cover no-repeat;
    mix-blend-mode: luminosity;
    opacity: 0.16;
    mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
  }

  :global(.quotes-section)::after {
    content: '\201C';
    position: absolute;
    z-index: -1;
    top: -0.08em;
    right: 2%;
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: clamp(14rem, 28vw, 26rem);
    line-height: 1;
    color: var(--c-surface);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    :global(.quotes-section)::before {
      background-image: url('/images/hero-bg-1800.webp');
    }
  }

  .band {
    display: grid;
    gap: var(--s-6);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .band {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-8);
    }
  }

  .band__more {
    margin: var(--s-4) 0 0;
  }
</style>
