---
/**
 * "How it works" — audit §5.2 section 4.
 *
 * Answers the audit's finding 8: nothing on the live site explains what
 * coaching actually is, which is the biggest unanswered question for a
 * first-time buyer.
 *
 * The steps read as a progression, not three tiles: each step's top rule
 * draws in from the left as the block comes into view, one after another,
 * and an arrow at the end of each rule points to the next step — across on
 * desktop, down the page on a phone. Without JS or with reduced motion the
 * rules and arrows are simply there.
 */
import { getCollection, render } from 'astro:content';
import Section from '../layout/Section.astro';

interface Props {
  /** Which version to render — see the `scope` field in src/content.config.ts. */
  scope?: 'home' | 'coaching' | 'org';
  heading?: string;
  id?: string;
  /** Sits on the light band by default — the mechanism is read, not felt. */
  tone?: 'bg' | 'surface' | 'light' | 'light-surface';
}

const { scope = 'home', heading = 'How it works', id = 'how-it-works', tone = 'light' } = Astro.props;

const steps = (
  await getCollection('steps', ({ data }) => data.scope === scope || data.scope === 'both')
).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  steps.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Section {tone} aria-labelledby={id}>
  <h2 {id}>{heading}</h2>

  {/* An ordered list, so the sequence is in the markup and not only the design. */}
  <ol class="steps stagger">
    {
      rendered.map(({ entry, Content }, i) => (
        <li>
          <h3>{entry.data.title}</h3>
          <Content />
          {/* Decorative: the numbers carry the order, the arrow carries the motion. */}
          {i < rendered.length - 1 && (
            <svg class="steps__arrow" aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
              <path
                d="M3 12h16M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    /* Stacked, the arrow under each step already makes the gap. */
    gap: var(--s-4);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    counter-increment: step;
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-line);
  }

  /* The track: a rule in the accent along the top edge of each step, over
     the hairline. It is what draws in. */
  .steps li::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--c-accent);
    transform-origin: left center;
  }

  /* The number is the design: a two-digit numeral in Bitter Black, the size
     of a heading, in the accent. It replaces the small filled circle, which
     read as a bullet. */
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    display: block;
    margin-bottom: var(--s-2);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-accent);
  }

  .steps h3 {
    margin-bottom: var(--s-1);
  }

  .steps :global(p) {
    max-width: var(--measure);
  }

  .steps :global(p:last-of-type) {
    margin-bottom: 0;
  }

  /* Stacked: the arrow sits under the step and points down to the next. */
  .steps__arrow {
    display: block;
    margin-top: var(--s-3);
    color: var(--c-accent);
    rotate: 90deg;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-8);
    }

    /* Five steps on the coaching page: two rows of three, not five across
       (audit §8.4: never five). The grid handles it; this keeps the rows
       from stretching to the tallest step. */
    .steps li {
      align-self: start;
    }

    /* Across: the track runs on into the column gap and hands off to an
       arrow centred in it, which points at the next step's track. The last
       step in a row has nothing to its right. */
    .steps li:not(:nth-child(3n))::after {
      width: calc(100% + var(--s-8) / 2 - 12px);
    }

    .steps__arrow {
      position: absolute;
      top: -12px;
      right: calc(-1 * var(--s-8) / 2 - 12px);
      margin: 0;
      rotate: 0deg;
    }

    .steps li:nth-child(3n) .steps__arrow {
      display: none;
    }
  }

  /* With the reveal active, the tracks draw in one after another once the
     block is in view, and each arrow arrives as its track reaches it. The
     gate mirrors `.reveal` in global.css: no JS or reduced motion, no change. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-reveal] .reveal) .steps li::after {
      transform: scaleX(0);
      transition: transform var(--dur-slow) var(--ease);
    }

    :global(html[data-reveal] .reveal.is-in) .steps li::after {
      transform: scaleX(1);
    }

    :global(html[data-reveal] .reveal) .steps__arrow {
      opacity: 0;
      translate: 0 -8px;
      transition:
        opacity var(--dur) var(--ease),
        translate var(--dur) var(--ease);
    }

    @media (min-width: 900px) {
      :global(html[data-reveal] .reveal) .steps__arrow {
        translate: -8px 0;
      }
    }

    :global(html[data-reveal] .reveal.is-in) .steps__arrow {
      opacity: 1;
      translate: 0 0;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(2)::after {
      transition-delay: 0.35s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(3)::after {
      transition-delay: 0.7s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(4)::after {
      transition-delay: 1.05s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(5)::after {
      transition-delay: 1.4s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(1) .steps__arrow {
      transition-delay: 0.5s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(2) .steps__arrow {
      transition-delay: 0.85s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(3) .steps__arrow {
      transition-delay: 1.2s;
    }

    :global(html[data-reveal] .reveal.is-in) .steps li:nth-child(4) .steps__arrow {
      transition-delay: 1.55s;
    }
  }
</style>
