---
/**
 * "How it works" — audit §5.2 section 4.
 *
 * Answers the audit's finding 8: nothing on the live site explains what
 * coaching actually is, which is the biggest unanswered question for a
 * first-time buyer.
 */
import { getCollection, render } from 'astro:content';
import Section from '../layout/Section.astro';

interface Props {
  /** Which version to render — see the `scope` field in src/content.config.ts. */
  scope?: 'home' | 'coaching' | 'org';
  heading?: string;
  id?: string;
  alt?: boolean;
}

const { scope = 'home', heading = 'How it works', id = 'how-it-works', alt = true } = Astro.props;

const steps = (
  await getCollection('steps', ({ data }) => data.scope === scope || data.scope === 'both')
).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  steps.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Section {alt} aria-labelledby={id}>
  <h2 {id}>{heading}</h2>

  {/* An ordered list, so the sequence is in the markup and not only the design. */}
  <ol class="steps stagger">
    {
      rendered.map(({ entry, Content }) => (
        <li>
          <h3>{entry.data.title}</h3>
          <Content />
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    gap: var(--s-6);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-8);
    }

    /* Five steps on the coaching page: two rows of three, not five across
       (audit §8.4: never five). The grid handles it; this keeps the rows
       from stretching to the tallest step. */
    .steps li {
      align-self: start;
    }
  }

  .steps li {
    counter-increment: step;
    padding-top: var(--s-3);
    border-top: 2px solid var(--c-accent);
  }

  /* The number is the design: a two-digit numeral in Bitter Black, the size
     of a heading, in the accent. It replaces the small filled circle, which
     read as a bullet. */
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    display: block;
    margin-bottom: var(--s-2);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-accent);
  }

  .steps h3 {
    margin-bottom: var(--s-1);
  }

  .steps :global(p) {
    max-width: var(--measure);
  }

  .steps :global(p:last-child) {
    margin-bottom: 0;
  }
</style>