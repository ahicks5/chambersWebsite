---
/**
 * Hero — audit §5.2 section 1, copy from §6.
 *
 * Fixes the audit's top finding: the live homepage opens with "Welcome!" as an
 * H2 and has no H1 at all. The hook is the H1 here, and it is the first thing
 * on the page.
 *
 * The h1 is rendered by this section rather than by Page.astro, because the hero
 * is a two-column layout and the heading belongs inside its text column.
 */
import Button from '../ui/Button.astro';
import Section from '../layout/Section.astro';

interface Props {
  h1: string;
  subhead: string;
}

const { h1, subhead } = Astro.props;
---

<Section size="roomy" class="hero">
  <div class="hero__grid">
    <div class="hero__text">
      <h1>{h1}</h1>
      <p class="hero__subhead">{subhead}</p>
      <Button cta="intro" page="home" position="hero" />
    </div>

    {/*
      Audit §5.2 wants John's photo beside the headline, and §10 makes it the LCP
      element: upload ~1500px wide, never lazy-load it, fixed 4:5 ratio to stop
      layout shift (§8.4).

      No photo is in the repo yet, so this reserves the exact box the image will
      occupy. Swapping in <Image> later changes no layout. Tracked in
      docs/parity-checklist.md.

      The offset frame behind the box is the one decorative element in the
      hero. It is drawn by a pseudo-element on the wrapper, so it costs no
      markup and survives the photo swap unchanged.
    */}
    <div class="hero__figure">
      <div class="hero__photo" role="presentation">
        <p class="hero__photo-note">Photo of John goes here — 4:5, ~1500px wide.</p>
      </div>
    </div>
  </div>
</Section>

<style>
  .hero__grid {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-12);
    }
  }

  .hero__text h1 {
    /* Six to eight words a line keeps the hook from running the column. */
    max-width: 16ch;
  }

  /* The subhead is the positioning line (audit §3.2 step 2), not a caption.
     Ink, not muted, and a touch larger than body. */
  .hero__subhead {
    max-width: 38ch;
    margin-block: var(--s-3) var(--s-6);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }

  .hero__figure {
    --frame: 0.75rem;
    position: relative;
    /* Explicit, because `justify-self: end` below would otherwise shrink the
       box to the width of the placeholder note. */
    width: 100%;
    /* Room for the frame, which sits down and to the right. Margin rather
       than overflow, so a phone never gains a horizontal scrollbar. */
    margin-inline-end: var(--frame);
    margin-bottom: var(--frame);
    max-width: 24rem;
  }

  @media (min-width: 900px) {
    .hero__figure {
      --frame: 1rem;
      max-width: 30rem;
      justify-self: end;
    }
  }

  .hero__figure::before {
    content: '';
    position: absolute;
    inset: var(--frame) calc(-1 * var(--frame)) calc(-1 * var(--frame)) var(--frame);
    background: var(--c-accent);
    border-radius: var(--radius);
  }

  .hero__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    padding: var(--s-3);
    background: var(--c-surface);
    border: 1px dashed var(--c-line);
    border-radius: var(--radius);
  }

  .hero__photo-note {
    margin: 0;
    max-width: 22ch;
    text-align: center;
    color: var(--c-muted);
    font-size: var(--fs-small);
  }
</style>
