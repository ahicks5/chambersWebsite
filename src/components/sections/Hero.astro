---
/**
 * Hero — audit §5.2 section 1, copy from §6.
 *
 * Fixes the audit's top finding: the live homepage opens with "Welcome!" as an
 * H2 and has no H1 at all. The hook is the H1 here, and it is the first thing
 * on the page.
 *
 * The h1 is rendered by this section rather than by Page.astro, because the hero
 * is a two-column layout and the heading belongs inside its text column.
 */
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Section from '../layout/Section.astro';
import { site } from '../../config/site';
import portrait from '../../assets/john-chambers.jpg';

interface Props {
  h1: string;
  subhead: string;
}

const { h1, subhead } = Astro.props;
---

<Section size="roomy" reveal={false} class="hero">
  <div class="hero__grid">
    <div class="hero__text">
      <h1>{h1}</h1>
      <p class="hero__subhead">{subhead}</p>
      <Button cta="intro" page="home" position="hero" />
    </div>

    {/*
      Audit §5.2 wants John's photo beside the headline, and §10 makes it the LCP
      element: ~1500px wide, never lazy-loaded, a fixed 4:5 ratio so nothing
      shifts while it loads (§8.4). The source is his studio headshot from the
      live site, cropped to 4:5 at 1600px; Astro resizes and re-encodes it at
      build time, so the browser fetches only the width it needs.

      The offset frame behind the photo is the one decorative element in the
      hero, drawn by a pseudo-element on the wrapper.
    */}
    <div class="hero__figure">
      <Image
        class="hero__photo"
        src={portrait}
        alt={site.person}
        widths={[480, 768, 1024, 1600]}
        sizes="(min-width: 900px) 30rem, (min-width: 640px) 24rem, calc(100vw - 3rem)"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
  </div>
</Section>

<style>
  /* A soft light behind the photo column, so the hero has depth rather than
     one flat fill. Tint over the page colour — no new colour. */
  :global(.hero) {
    background:
      radial-gradient(60% 55% at 78% 30%, var(--c-surface), transparent 70%),
      var(--c-bg);
  }

  .hero__grid {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-12);
    }
  }

  .hero__text h1 {
    /* Six to eight words a line keeps the hook from running the column. */
    max-width: 16ch;
  }

  /* The subhead is the positioning line (audit §3.2 step 2), not a caption.
     Ink, not muted, and a touch larger than body. */
  .hero__subhead {
    max-width: 38ch;
    margin-block: var(--s-3) var(--s-6);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }

  /* On a phone the lede at 20px ran to five lines under a four-line h1 and
     read as a paragraph, not a subhead. Body size keeps it to four. */
  @media (max-width: 639px) {
    .hero__subhead {
      font-size: var(--fs-body);
    }
  }

  .hero__figure {
    --frame: 0.75rem;
    position: relative;
    /* Explicit, because `justify-self: end` below would otherwise shrink the
       box to the width of the placeholder note. */
    width: 100%;
    /* Room for the frame, which sits down and to the right. Margin rather
       than overflow, so a phone never gains a horizontal scrollbar. */
    margin-inline-end: var(--frame);
    margin-bottom: var(--frame);
    max-width: 24rem;
  }

  @media (min-width: 900px) {
    .hero__figure {
      --frame: 1rem;
      max-width: 30rem;
      justify-self: end;
    }
  }

  /* An outline offset down and to the right, not a filled block: a filled
     one read as a second slab behind the photo. */
  .hero__figure::before {
    content: '';
    position: absolute;
    inset: var(--frame) calc(-1 * var(--frame)) calc(-1 * var(--frame)) var(--frame);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
  }

  /* A child component's root element, so :global() — see Header.astro. */
  .hero__figure :global(.hero__photo) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* The calm reveal: headline, line, button, then the photo, each rising a
     little as it fades in. CSS only, so it costs nothing and starts before
     any script runs. Reduced motion collapses it to an instant (global.css). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__text > *,
    .hero__figure {
      animation: rise var(--dur-slow) var(--ease) both;
    }

    .hero__text > :nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero__text > :nth-child(3) {
      animation-delay: 0.24s;
    }

    .hero__figure {
      animation-delay: 0.18s;
    }
  }

</style>
