---
/**
 * Hero — audit §5.2 section 1, copy from §6.
 *
 * Fixes the audit's top finding: the live homepage opens with "Welcome!" as an
 * H2 and has no H1 at all. The hook is the H1 here, and it is the first thing
 * on the page.
 *
 * The h1 is rendered by this section rather than by Page.astro, because the hero
 * is a two-column layout and the heading belongs inside its text column.
 */
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Section from '../layout/Section.astro';
import { site } from '../../config/site';
import portrait from '../../assets/john-chambers-cutout.webp';

interface Props {
  h1: string;
  subhead: string;
}

const { h1, subhead } = Astro.props;
---

<Section size="roomy" reveal={false} class="hero">
  <div class="hero__grid">
    <div class="hero__text">
      <h1>{h1}</h1>
      <p class="hero__subhead">{subhead}</p>
      <Button cta="intro" page="home" position="hero" />
    </div>

    {/*
      Audit §5.2 wants John's photo beside the headline, and §10 makes it the LCP
      element: ~1500px wide, never lazy-loaded, a fixed 4:5 ratio so nothing
      shifts while it loads (§8.4). The source is his studio headshot with the
      flat grey backdrop keyed out (scripts/cutout-backdrop.mjs), cropped to
      4:5 at 1600px; Astro resizes and re-encodes it at build time, so the
      browser fetches only the width it needs.

      With the backdrop gone he sits on the page colour itself rather than in
      a grey rectangle on it. The outline frame behind him is the one
      decorative element: it starts below the top of his head, so he rises out
      of it, and his torso fades into the green at the bottom edge.
    */}
    <div class="hero__figure">
      <Image
        class="hero__photo"
        src={portrait}
        alt={site.person}
        widths={[480, 768, 1024, 1600]}
        sizes="(min-width: 900px) 30rem, (min-width: 640px) 24rem, calc(100vw - 3rem)"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
  </div>
</Section>

<style>
  /* A soft light behind the photo column, so the hero has depth rather than
     one flat fill. Tint over the page colour — no new colour. */
  :global(.hero) {
    background:
      radial-gradient(60% 55% at 78% 30%, var(--c-surface), transparent 70%),
      var(--c-bg);
  }

  .hero__grid {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-12);
    }
  }

  .hero__text h1 {
    /* Six to eight words a line keeps the hook from running the column. */
    max-width: 16ch;
  }

  /* The subhead is the positioning line (audit §3.2 step 2), not a caption.
     Ink, not muted, and a touch larger than body. */
  .hero__subhead {
    max-width: 38ch;
    margin-block: var(--s-3) var(--s-6);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }

  /* On a phone the lede at 20px ran to five lines under a four-line h1 and
     read as a paragraph, not a subhead. Body size keeps it to four. */
  @media (max-width: 639px) {
    .hero__subhead {
      font-size: var(--fs-body);
    }
  }

  .hero__figure {
    --frame: 0.75rem;
    position: relative;
    /* Explicit, because `justify-self: end` below would otherwise shrink the
       box to the width of the placeholder note. */
    width: 100%;
    /* Room for the frame, which sits down and to the right. Margin rather
       than overflow, so a phone never gains a horizontal scrollbar. */
    margin-inline-end: var(--frame);
    margin-bottom: var(--frame);
    max-width: 24rem;
  }

  @media (min-width: 900px) {
    .hero__figure {
      --frame: 1rem;
      max-width: 30rem;
      justify-self: end;
    }
  }

  /* An outline behind him, not a filled block: a filled one read as a second
     slab. Its top edge sits a fifth of the way down, below the crown of his
     head, so the portrait breaks out of the frame instead of sitting in it. */
  .hero__figure::before {
    content: '';
    position: absolute;
    inset: 22% calc(-1 * var(--frame)) calc(-1 * var(--frame)) var(--frame);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
  }

  /* Below the two-column breakpoint the portrait goes first, top right, at a
     little over half the width, and the headline block rides up over its
     faded lower edge. The face is in the first screen with the hook instead
     of parked under the button. The text stacks above the figure, and the
     overlap is confined to the part the mask has already faded, so it never
     covers a word. After the base figure rules on purpose: same specificity,
     so source order decides. */
  @media (max-width: 899px) {
    .hero__grid {
      gap: 0;
    }

    .hero__figure {
      order: -1;
      justify-self: end;
      width: 58%;
      max-width: 20rem;
      /* The bottom 22% of the figure, in the container-width terms that
         percentage margins use: 0.58 wide × 1.25 tall × 0.22. */
      margin-bottom: -16%;
    }

    /* The frame stops where the headline begins. */
    .hero__figure::before {
      bottom: 24%;
    }

    .hero__text {
      position: relative;
      z-index: 1;
    }
  }

  /* A child component's root element, so :global() — see Header.astro.
     The bottom fifth fades to transparent so the crop across his chest
     dissolves into the page rather than ending on a hard line. */
  .hero__figure :global(.hero__photo) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    mask-image: linear-gradient(to top, transparent, black 22%);
    -webkit-mask-image: linear-gradient(to top, transparent, black 22%);
  }

  /* The calm reveal: headline, line, button, then the photo, each rising a
     little as it fades in. CSS only, so it costs nothing and starts before
     any script runs. Reduced motion collapses it to an instant (global.css). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__text > *,
    .hero__figure {
      animation: rise var(--dur-slow) var(--ease) both;
    }

    .hero__text > :nth-child(2) {
      animation-delay: 0.12s;
    }

    .hero__text > :nth-child(3) {
      animation-delay: 0.24s;
    }

    .hero__figure {
      animation-delay: 0.18s;
    }
  }

</style>
