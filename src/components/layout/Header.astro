---
/**
 * Site header — audit §5.1. Nav plus the one primary CTA, which the audit wants
 * visible on every page.
 *
 * Sticky positioning is CSS-only. The scroll-state shadow (audit §9.1) needs an
 * IntersectionObserver island and is not built yet — it is not needed until
 * there is a hero to observe.
 */
import { site } from '../../config/site';
import { primaryNav } from '../../config/nav';
import Button from '../ui/Button.astro';
import Nav from './Nav.astro';
import type { CtaKey } from '../../config/cta';

interface Props {
  /** Page identifier for CTA attribution, e.g. `home`. */
  page: string;
  /**
   * Which primary CTA the header shows. Audit §5.1 puts the intro call in the
   * header site-wide, which is right for every page aimed at individuals. The
   * organizations page passes `consult` instead, so that screen offers one
   * action rather than two competing ones (audit §4.3).
   */
  cta?: Extract<CtaKey, 'intro' | 'consult'>;
}

const { page, cta = 'intro' } = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__brand">{site.name}</a>
    <Nav items={primaryNav} label="Primary" scrollable class="header__nav" />
    <Button {cta} page={page} position="header" size="compact" class="header__cta" />
  </div>
</header>

<style>
  .header {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }

  /**
   * Pinned only where the header is one short row. At phone widths the nav
   * wraps and the header runs ~173px tall, which would eat a quarter of the
   * viewport if fixed. Phones get the bottom CTA strip instead — see
   * StickyCta.astro, which is audit §9.1's answer to exactly this.
   */
  @media (min-width: 640px) {
    .header {
      position: sticky;
      top: 0;
      z-index: 10;
      transition: box-shadow 0.2s ease;
    }

    /* Set by the observer in StickyCta once the hero has scrolled past. */
    .header.is-scrolled {
      box-shadow: 0 2px 12px rgb(0 0 0 / 0.08);
    }
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--s-2) var(--s-3);
  }

  .header__brand {
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 1.05rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--c-accent);
    text-decoration: none;
  }

  /*
   * `:global()` on purpose. Nav and Button are child components, and Astro
   * does not put this file's scope attribute on a child's root element, so a
   * plain `.header__nav` rule here matches nothing. The classes are still set
   * only from this file, so the reach is the same as a scoped rule.
   */
  .header__inner > :global(.header__nav) {
    margin-right: auto;
  }

  /**
   * Below 900px the three pieces do not fit on one row. Rather than let the
   * CTA fall to a third row (which is what free wrapping does at 375px and
   * 768px alike), brand and CTA share the first row and the nav sits under
   * them on its own row, scrolling sideways on phones if it must. Two rows,
   * never three. The brand takes what the CTA leaves and wraps to a balanced
   * second line when it has to.
   */
  @media (max-width: 899px) {
    .header__inner {
      gap: var(--s-2);
    }

    .header__brand {
      flex: 1 1 0;
      min-width: 0;
      font-size: 0.95rem;
      text-wrap: balance;
    }

    .header__inner > :global(.header__cta) {
      order: 2;
    }

    .header__inner > :global(.header__nav) {
      order: 3;
      flex: 1 0 100%;
      margin-right: 0;
      min-width: 0;
    }
  }
</style>
