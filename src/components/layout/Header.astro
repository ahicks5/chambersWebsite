---
/**
 * Site header — audit §5.1. Nav plus the one primary CTA, which the audit wants
 * visible on every page.
 *
 * Sticky positioning is CSS-only. The scroll-state shadow (audit §9.1) needs an
 * IntersectionObserver island and is not built yet — it is not needed until
 * there is a hero to observe.
 */
import { site } from '../../config/site';
import { primaryNav } from '../../config/nav';
import Button from '../ui/Button.astro';
import Nav from './Nav.astro';
import type { CtaKey } from '../../config/cta';

interface Props {
  /** Page identifier for CTA attribution, e.g. `home`. */
  page: string;
  /**
   * Which primary CTA the header shows. Audit §5.1 puts the intro call in the
   * header site-wide, which is right for every page aimed at individuals. The
   * organizations page passes `consult` instead, so that screen offers one
   * action rather than two competing ones (audit §4.3).
   */
  cta?: Extract<CtaKey, 'intro' | 'consult'>;
}

const { page, cta = 'intro' } = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__brand">{site.name}</a>
    <Nav items={primaryNav} label="Primary" scrollable class="header__nav" />
    <Button {cta} page={page} position="header" size="compact" class="header__cta" />
  </div>
</header>

<style>
  .header {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }

  /**
   * Sticky only where the header is one short row. At phone widths the nav
   * wraps and the header runs ~360px tall, which would eat 40% of the viewport
   * if pinned.
   *
   * The compact mobile header and the bottom-anchored CTA strip that audit §9.1
   * asks for both belong to Milestone 1, when the real header is built. Until
   * then this scrolls away rather than shipping a broken pin.
   */
  @media (min-width: 640px) {
    .header {
      position: sticky;
      top: 0;
      z-index: 10;
    }
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--s-2) var(--s-3);
  }

  .header__brand {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--c-text);
    text-decoration: none;
  }

  .header__nav {
    margin-right: auto;
  }

  /**
   * On phones the nav would wrap to two rows and push the h1 below the fold.
   * Brand and CTA share the first row; the nav sits under them on its own row
   * and scrolls sideways if it needs to.
   */
  @media (max-width: 639px) {
    .header__brand {
      flex: 1 1 auto;
    }

    .header__cta {
      order: 2;
    }

    .header__nav {
      order: 3;
      flex: 1 0 100%;
      margin-right: 0;
      /* Cancel the wrapper's row gap; the ul carries its own padding. */
      min-width: 0;
    }
  }
</style>
