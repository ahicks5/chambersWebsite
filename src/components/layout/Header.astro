---
/**
 * Site header — audit §5.1. Nav plus the one primary CTA, which the audit wants
 * visible on every page.
 *
 * Sticky positioning is CSS-only. The scroll-state shadow (audit §9.1) needs an
 * IntersectionObserver island and is not built yet — it is not needed until
 * there is a hero to observe.
 */
import { site } from '../../config/site';
import { primaryNav } from '../../config/nav';
import Button from '../ui/Button.astro';
import Nav from './Nav.astro';

interface Props {
  /** Page identifier for CTA attribution, e.g. `home`. */
  page: string;
}

const { page } = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__brand">{site.name}</a>
    <Nav items={primaryNav} label="Primary" class="header__nav" />
    <Button cta="intro" page={page} position="header" class="header__cta" />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--s-2) var(--s-3);
  }

  .header__brand {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--c-text);
    text-decoration: none;
  }

  .header__nav {
    margin-right: auto;
  }

  /* The header CTA stays compact; Button's mobile full-width rule is for
     in-page CTAs, not this one. */
  .header__cta {
    display: inline-block;
    width: auto;
    padding: 0.55rem 1.1rem;
    font-size: 0.95rem;
  }
</style>
