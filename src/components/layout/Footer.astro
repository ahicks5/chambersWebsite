---
/**
 * Site footer.
 *
 * The year and business name are rendered, never typed. Audit §2.8 bug 2: the
 * live blog footer reads "© 2024 by JC Consulting & Consulting" — two errors in
 * one line. That cannot happen here.
 *
 * Social links live in the footer only, never the top of the page (audit §2.8
 * bug 8), and are not rendered until the URLs in site.ts are confirmed.
 */
import { site } from '../../config/site';
import { footerNav } from '../../config/nav';
import Nav from './Nav.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <Nav items={footerNav} label="Footer" />

    <p class="footer__credentials">{[...site.credentials, ...site.trainedAt].join(' · ')}</p>

    {/* Single line on purpose: Astro 7 compresses whitespace by JSX rules, so a
        newline between inline expressions is dropped rather than collapsed to a
        space. See docs/decisions/0004-astro-7.md. */}
    <p class="footer__legal">
      © {year} {site.name} · <a href={`mailto:${site.email}`}>{site.email}</a> · {`${site.locality}, ${site.region}`}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-surface);
    border-top: 1px solid var(--c-line);
  }

  .footer__inner {
    display: grid;
    gap: var(--s-3);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--s-8) var(--s-3);
  }

  .footer__credentials,
  .footer__legal {
    margin: 0;
    color: var(--c-muted);
    font-size: 0.95rem;
  }

  .footer__legal a {
    color: inherit;
  }
</style>
