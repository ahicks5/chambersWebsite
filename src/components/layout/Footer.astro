---
/**
 * Site footer — audit §5.1, §3.3.
 *
 * The year and business name are rendered, never typed. Audit §2.8 bug 2: the
 * live blog footer reads "© 2024 by JC Consulting & Consulting" — two errors in
 * one line. That cannot happen here.
 *
 * Four columns on a wide screen: the brand with its positioning line and the
 * page's primary CTA (the audit wants that CTA in the footer as well as the
 * hero); the two link groups from src/config/nav.ts; and how to reach John.
 * Under them, the credentials as a tracked line — §3.3 asks for the ICF
 * credential in every footer — and the legal line.
 *
 * Social links live in the footer only, never the top of the page (audit §2.8
 * bug 8), and are not rendered until the URLs in site.ts are confirmed.
 */
import { getEntry } from 'astro:content';
import { site } from '../../config/site';
import { footerGroups } from '../../config/nav';
import type { CtaKey } from '../../config/cta';
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  /** Page identifier for CTA attribution, e.g. `home`. */
  page: string;
  /** Mirrors the header: organizations pages pass `consult` (audit §4.3). */
  cta?: Extract<CtaKey, 'intro' | 'consult'>;
}

const { page, cta = 'intro' } = Astro.props;

// The positioning line under the wordmark is the homepage subhead — one
// sentence John already owns, not a second one written for the footer.
const home = await getEntry('pages', 'home');
const line = home?.data.subhead;

const year = new Date().getFullYear();
const proof = [...site.credentials.map((c) => c.short), ...site.trainedAt];

// Profiles, from site.ts. Only real URLs render (audit §2.8 bug 8: footer
// only, and never a dead link). The glyphs are simple line drawings, not the
// networks' trademarked logos.
const NETWORKS = {
  linkedin: { label: 'LinkedIn', path: 'M4 9h3.4v11H4zM5.7 4a2 2 0 1 1 0 4 2 2 0 0 1 0-4M9.6 9h3.3v1.5c.5-.9 1.7-1.8 3.5-1.8 3.7 0 4.4 2.4 4.4 5.6V20h-3.4v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20H9.6z' },
  instagram: { label: 'Instagram', path: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3zm0 2A2.5 2.5 0 0 0 5 7.5v9A2.5 2.5 0 0 0 7.5 19h9a2.5 2.5 0 0 0 2.5-2.5v-9A2.5 2.5 0 0 0 16.5 5zM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm5-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z' },
  tiktok: { label: 'TikTok', path: 'M13.5 3h3c.2 2.3 1.6 3.7 4 3.9v3c-1.5 0-2.9-.5-4-1.3V15a5.5 5.5 0 1 1-5.5-5.5h.5v3.1a2.4 2.4 0 1 0 2 2.4z' },
  x: { label: 'X', path: 'M4 3h4.3l4 5.6L17.2 3H20l-6.4 7.4L20.5 21h-4.3l-4.3-6-5.2 6H4l6.8-7.8z' },
} as const;

const socials = (Object.keys(NETWORKS) as (keyof typeof NETWORKS)[])
  .map((key) => ({ key, href: site.social[key], ...NETWORKS[key] }))
  .filter(({ href }) => href.startsWith('https://'));
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__wordmark">
          <Logo size={26} />
          <span>{site.name}</span>
        </a>
        {line && <p class="footer__line">{line}</p>}
        <Button {cta} {page} position="footer" size="compact" class="footer__cta" />
      </div>

      {
        footerGroups.map((group) => (
          <div class="footer__group">
            <span class="eyebrow footer__eyebrow">{group.label}</span>
            <Nav items={group.items} label={group.label} stack />
          </div>
        ))
      }

      <div class="footer__group footer__group--contact">
        <span class="eyebrow footer__eyebrow">Contact</span>
        <ul class="footer__contact">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{`${site.locality}, ${site.region}`}</li>
        </ul>

        {
          socials.length > 0 && (
            <ul class="footer__social" aria-label="Profiles">
              {socials.map(({ href, label, path }) => (
                <li>
                  <a href={href} rel="me noopener" aria-label={label} title={label}>
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                      <path d={path} fill="currentColor" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="footer__bottom">
      <ul class="footer__proof" aria-label="Credentials">
        {proof.map((item) => <li>{item}</li>)}
      </ul>
      <p class="footer__legal">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  /* On the surface tint, so the footer reads as the page's base rather than
     more of the closing band above it. */
  .footer {
    background: var(--c-surface);
    border-top: 1px solid var(--c-line);
  }

  .footer__inner {
    display: grid;
    gap: var(--s-6);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--s-8) var(--s-3) var(--s-6);
  }

  @media (min-width: 900px) {
    .footer__inner {
      padding-top: var(--s-12);
    }
  }

  /* Two columns even on a phone: the link groups sit side by side, and the
     brand and the contact block each take a full row. */
  .footer__top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-4);
  }

  .footer__brand,
  .footer__group--contact {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 1.3fr);
      gap: var(--s-8);
    }

    .footer__brand,
    .footer__group--contact {
      grid-column: auto;
    }
  }

  /* Child component roots do not carry this file's scope attribute. */
  .footer__group :global(.nav a) {
    font-size: var(--fs-small);
  }

  .footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--c-accent);
    text-decoration: none;
  }

  .footer__line {
    max-width: 36ch;
    margin: var(--s-2) 0 var(--s-3);
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .footer__eyebrow {
    margin-bottom: var(--s-2);
    color: var(--c-muted);
  }

  .footer__contact {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__contact {
    font-size: var(--fs-small);
  }

  .footer__contact a {
    color: var(--c-text);
    text-decoration-color: var(--c-line-strong);
    overflow-wrap: anywhere;
  }

  /* Profiles as rings — the site's small-mark motif — at a full tap size. */
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-text);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .footer__social a:hover,
  .footer__social a:focus-visible {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
  }

  /* The proof line, set the way the proof strip sets the institutions. */
  .footer__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .footer__proof li {
    display: inline-flex;
    gap: var(--s-2);
  }

  .footer__proof li:not(:last-child)::after {
    content: '·';
  }

  .footer__legal {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-muted);
  }
</style>
