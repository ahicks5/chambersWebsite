---
/**
 * Vertical rhythm and the alternating background band from audit §8.4, so the
 * eye can tell where one idea ends.
 *
 * Two knobs beyond the audit's single `.section--alt`: a size, because a proof
 * strip at "¼ screen" (§5.2) and a hero at "1 screen" cannot share one
 * padding; and a tone, because a page where every band is the same height and
 * the background merely toggles reads as flat. See ADR 0009.
 */
interface Props {
  /** Alternate background — shorthand for `tone="surface"`. */
  alt?: boolean;
  /**
   * Background. `accent` swaps text and background colours; use it once per
   * page. `light` is the audit's white page as a band inside the green one
   * (ADR 0010) — every colour role inside it is the light scheme's.
   */
  tone?: 'bg' | 'surface' | 'accent' | 'light' | 'light-surface';
  /** A one-pixel rule along the top edge, for two same-tone sections in a row. */
  rule?: boolean;
  /** Vertical padding. `compact` for strips, `roomy` for the hero. */
  size?: 'compact' | 'default' | 'roomy';
  /** Rise into view on scroll (global.css). The hero opts out; it has its own entrance. */
  reveal?: boolean;
  /**
   * A soft light in one upper corner, in the band's own secondary colour —
   * the surface tint on a page-coloured band, the page colour on a surface
   * one. Depth without a new colour; the hero's glow, made a knob.
   */
  glow?: 'left' | 'right';
  id?: string;
  /** Set when the section is introduced by a heading, for the a11y tree. */
  'aria-labelledby'?: string;
  class?: string;
}

const {
  alt = false,
  tone = alt ? 'surface' : 'bg',
  size = 'default',
  reveal = true,
  rule = false,
  glow,
  id,
  class: className,
  ...rest
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'section',
    tone !== 'bg' && `section--${tone}`,
    (tone === 'light' || tone === 'light-surface') && 'scheme-light',
    rule && 'section--rule',
    size !== 'default' && `section--${size}`,
    glow && `section--glow-${glow}`,
    className,
  ]}
  {...rest}
>
  <div class:list={['section__inner', reveal && 'reveal']}>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--s-8);
  }

  .section--compact {
    padding-block: var(--s-4);
  }

  .section--roomy {
    padding-block: var(--s-8);
  }

  @media (min-width: 900px) {
    .section {
      padding-block: var(--s-12);
    }

    .section--compact {
      padding-block: var(--s-6);
    }

    .section--roomy {
      padding-block: var(--s-16);
    }
  }

  .section--surface {
    background: var(--c-surface);
  }

  .section--light {
    background: var(--c-bg);
    color: var(--c-text);
  }

  .section--light-surface {
    background: var(--c-surface);
    color: var(--c-text);
  }

  .section--rule {
    border-top: 1px solid var(--c-line);
  }

  /* The glow: a radial tint in the band's secondary colour, after the tone
     rules so it wins the background-image slot. On a surface-toned band the
     light is the page colour instead, so it still reads as a lift. */
  .section--glow-left,
  .section--glow-right {
    --glow: var(--c-surface);
    background-image: radial-gradient(55% 70% at var(--glow-x) 15%, var(--glow), transparent 70%);
  }

  .section--glow-left {
    --glow-x: 12%;
  }

  .section--glow-right {
    --glow-x: 88%;
  }

  .section--surface.section--glow-left,
  .section--surface.section--glow-right,
  .section--light-surface.section--glow-left,
  .section--light-surface.section--glow-right {
    --glow: var(--c-bg);
  }

  /* One accent band per page at most. Everything inside is set in the ink
     colour, including headings, which are otherwise accent-on-accent. */
  .section--accent {
    background: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .section--accent :global(h1),
  .section--accent :global(h2),
  .section--accent :global(h3),
  .section--accent :global(a:not(.button)) {
    color: inherit;
  }

  .section__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--s-3);
  }
</style>
