---
/**
 * Coaching — implements the audit §5.3 blueprint in order.
 *
 * Half of the split of the old /current-services page, which had two H1s on it
 * (audit §2.8 bug 5). /current-services 301s here — see public/_redirects.
 */
import { getCollection, getEntry } from 'astro:content';

import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import ForWho from '../components/sections/ForWho.astro';
import OfferCards from '../components/sections/OfferCards.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import TestimonialBand from '../components/sections/TestimonialBand.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SchemaFaq from '../components/seo/SchemaFaq.astro';

const page = await getEntry('pages', 'coaching');
if (!page) throw new Error('Missing src/content/pages/coaching.md');
const { title, description, h1, subhead, forWho, notForWho } = page.data;

const faqs = (await getCollection('faqs', ({ data }) => data.page === 'coaching')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base {title} {description} page="coaching">
  <SchemaFaq {faqs} slot="head" />

  <Section>
    <h1>{h1}</h1>
    {subhead && <p class="subhead">{subhead}</p>}
  </Section>

  <ForWho {forWho} {notForWho} />
  <OfferCards segment="individual" page="coaching" heading="Ways to work together" />
  <HowItWorks scope="coaching" heading="How the work goes" />
  <TestimonialBand segment="individual" alt={false} />
  <FaqAccordion {faqs} alt />
  <FinalCta band="final-cta-coaching" cta="intro" page="coaching" />
</Base>

<style>
  .subhead {
    max-width: var(--measure);
    margin-block: var(--s-3) 0;
    color: var(--c-muted);
    font-size: 1.25rem;
  }
</style>
