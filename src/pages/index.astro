---
/**
 * Homepage — implements the audit §5.2 blueprint in order, with copy from §6.
 *
 * The blueprint table is the page composition, so the sections below read in the
 * same sequence as the audit's rows. Copy and prices come from src/content/;
 * nothing user-facing is typed into this file except the section order.
 *
 * Uses Base rather than Page, because the hero renders its own h1 inside a
 * two-column layout. There is still exactly one h1 on the page.
 */
import { getEntry } from 'astro:content';

import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import SymptomGrid from '../components/sections/SymptomGrid.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import OfferCards from '../components/sections/OfferCards.astro';
import TestimonialBand from '../components/sections/TestimonialBand.astro';
import MeetJohn from '../components/sections/MeetJohn.astro';
import OrgBand from '../components/sections/OrgBand.astro';
import LeadMagnet from '../components/sections/LeadMagnet.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SchemaProfessionalService from '../components/seo/SchemaProfessionalService.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');

// Title and description are schema-validated for length and uniqueness, so a
// page cannot ship with a missing or borrowed meta description (audit §2.8 bug 3).
const { title, description, h1, subhead } = home.data;
---

<Base {title} {description} page="home">
  <SchemaProfessionalService {description} slot="head" />

  <Hero {h1} subhead={subhead ?? ''} />
  <ProofStrip />
  <SymptomGrid />
  <HowItWorks />
  <OfferCards />
  <TestimonialBand />
  <MeetJohn />
  <OrgBand />
  <LeadMagnet />
  <FinalCta band="final-cta-home" cta="intro" page="home" />
</Base>
