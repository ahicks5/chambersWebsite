---
/**
 * Privacy — audit §2.8 bug 15 and §7.6.
 *
 * The live site collects personal details through a Wix form with no policy and
 * no notice anywhere. This page describes only what the site actually does
 * today: two forms, a Calendly embed, and ordinary server logs. There is no
 * analytics section because analytics are not wired yet — when GA4 lands
 * (audit §11), this page has to change with it.
 *
 * Not legal advice and not reviewed by a lawyer. See docs/parity-checklist.md.
 */
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import PageHero from '../components/sections/PageHero.astro';
import Prose from '../components/ui/Prose.astro';

const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('Missing src/content/pages/privacy.md');
const { title, description, h1, subhead } = page.data;
const { Content } = await render(page);
---

<Base {title} {description} page="privacy">
  <PageHero {h1} {subhead} focus="sky" />

  <Section alt>
    <Prose>
      <Content />
    </Prose>
  </Section>
</Base>
