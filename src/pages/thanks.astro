---
/**
 * Where both forms land after a successful submit.
 *
 * Netlify redirects here because each form sets action="/thanks/". Without it
 * people get Netlify's generic success page, which is unbranded and says
 * nothing about what happens next — the same "no expectation set" problem audit
 * §2.7 flags on the live Contact page.
 *
 * noindex: it is a dead end for search traffic, reachable only after a submit.
 */
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import PageHero from '../components/sections/PageHero.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';

const page = await getEntry('pages', 'thanks');
if (!page) throw new Error('Missing src/content/pages/thanks.md');
const { title, description, h1, subhead, noindex } = page.data;
const { Content } = await render(page);
---

<Base {title} {description} page="thanks" {noindex}>
  <PageHero {h1} {subhead} flip />

  <Section alt>
    <Prose>
      <Content />
    </Prose>
    <p class="cta">
      <Button cta="intro" page="thanks" position="body" />
    </p>
  </Section>
</Base>

<style>
  .cta {
    margin-top: var(--s-4);
  }
</style>
